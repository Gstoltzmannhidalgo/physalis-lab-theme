{
  "sections": {
    "hero": {
      "type": "rich-text",
      "blocks": {
        "caption": {
          "type": "caption",
          "settings": {
            "caption": "Physalis Lab",
            "text_style": "caption-with-letter-spacing"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Las manos detrás de cada pieza",
            "heading_size": "h0"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Cada objeto Physalis nace de una autora o autor independiente. Conocé a quienes diseñan las piezas que después se imprimen — bajo pedido — para tu hogar.</p>"
          }
        }
      },
      "block_order": ["caption", "heading", "text"],
