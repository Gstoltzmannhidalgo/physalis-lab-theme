            "link_label": "",
            "link": ""
          }
        },
        "paso-2": {
          "type": "column",
          "settings": {
            "title": "02 · Impresión",
            "text": "<p>La imprimimos en 3D bajo pedido en Chile, con materiales seleccionados.</p>",
