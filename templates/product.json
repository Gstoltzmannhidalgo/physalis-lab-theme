{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        },
        "collapsible-materiales": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Materiales",
            "icon": "leather",
            "content": "<p>Filamento PLA biodegradable de origen vegetal · Producido en Chile bajo pedido.</p>",
            "page": ""
          }
        },
        "collapsible-dimensiones": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Dimensiones",
            "icon": "ruler",
            "content": "",
            "page": ""
          }
        },
        "collapsible-envio": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Envío y devoluciones",
            "icon": "truck",
            "content": "<p>Despacho a todo Chile vía Starken o Chilexpress · 5 a 8 días hábiles desde la confirmación del pago.</p>",
            "page": ""
          }
        },
        "collapsible-cuidados": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Cuidados",
            "icon": "heart",
            "content": "<p>Limpieza con paño húmedo · Evitar fuentes de calor superiores a 60°C.</p>",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Compartir"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "caption",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "collapsible-materiales",
        "collapsible-dimensiones",
        "collapsible-envio",
        "collapsible-cuidados",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "gallery_layout": "thumbnail",
        "media_size": "large",
        "constrain_to_viewport": true,
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 48,
        "padding_bottom": 16
      }
    },
    "tagline": {
      "type": "rich-text",
      "blocks": {
        "caption": {
          "type": "caption",
          "settings": {
            "caption": "Physalis Lab",
            "text_style": "caption-with-letter-spacing"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Diseño de autor en tu hogar",
            "heading_size": "h0"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Cada pieza nace de la mano de una diseñadora o un diseñador, y se imprime sólo cuando la pedís. Sin stock, sin desperdicio, sin intermediarios.</p>"
          }
        }
      },
      "block_order": ["caption", "heading", "text"],
      "settings": {
        "color_scheme": "scheme-3",
        "full_width": true,
        "padding_top": 64,
        "padding_bottom": 64
      }
    },
    "destacados": {
      "type": "multicolumn",
      "blocks": {
        "destacado-1": {
          "type": "column",
          "settings": {
            "title": "Autoría firmada",
            "text": "<p>Cada pieza viene con la firma del diseñador y el sello Physalis.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "destacado-2": {
          "type": "column",
          "settings": {
            "title": "Impreso en Chile",
            "text": "<p>Producción local bajo pedido en filamentos seleccionados.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "destacado-3": {
          "type": "column",
          "settings": {
            "title": "Cero stock",
            "text": "<p>No producimos lo que no se pide. Menos desperdicio, más intención.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": ["destacado-1", "destacado-2", "destacado-3"],
      "settings": {
        "title": "",
        "heading_size": "h2",
        "image_width": "full",
        "image_ratio": "adapt",
        "columns_desktop": 3,
        "column_alignment": "left",
        "background_style": "none",
        "button_label": "",
        "button_link": "",
        "swipe_on_mobile": false,
        "color_scheme": "scheme-1",
        "columns_mobile": "1",
        "padding_top": 56,
        "padding_bottom": 56
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "También te puede interesar",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "show_secondary_image": true,
        "show_vendor": true,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 48,
        "padding_bottom": 64
      }
    }
  },
  "order": [
    "main",
    "tagline",
    "destacados",
    "related-products"
  ]
}
