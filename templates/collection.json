{
  "sections": {
    "banner": {
      "type": "main-collection-banner",
      "settings": {
        "show_collection_description": true,
        "show_collection_image": false,
        "color_scheme": "scheme-3"
      }
    },
    "puente_catalogo": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"physalis-bridge\" style=\"background:#E0A94A;padding:42px 32px;text-align:center;\">\n  <p style=\"font-family:var(--font-heading-family,'Fraunces',serif);font-style:italic;font-size:clamp(1.3rem,2.2vw,1.75rem);color:#3E2418;margin:0;\">Cada pieza se imprime cuando la pedís. Sin stock.</p>\n</section>",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_page": 16,
        "columns_desktop": 4,
        "image_ratio": "portrait",
        "show_secondary_image": true,
        "show_vendor": true,
        "show_rating": false,
        "enable_filtering": true,
        "filter_type": "vertical",
        "enable_sorting": true,
        "columns_mobile": "2",
        "padding_top": 48,
        "padding_bottom": 64
      }
    },
    "cierre_catalogo": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"physalis-bridge\" style=\"background:#7BA88A;padding:42px 32px;text-align:center;\">\n  <p style=\"font-family:var(--font-heading-family,'Fraunces',serif);font-style:italic;font-size:clamp(1.3rem,2.2vw,1.75rem);color:#FAF0CF;margin:0;\">¿No encontraste lo que buscás? Pedímoslo a medida.</p>\n</section>",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
  "order": [
    "banner",
    "puente_catalogo",
    "product-grid",
    "cierre_catalogo"
  ]
}
